{
  "uid": "documind-overview",
  "title": "DocuMind Overview",
  "description": "Request latency, ingestion pipeline throughput and failure rate, and per-workspace token usage.",
  "tags": [
    "documind"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Documents indexed (24h)",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "documind-prometheus"
      },
      "description": "Documents that completed ingestion in the last 24 hours.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "documind-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(documind_ingestion_documents_total{result=\"indexed\"}[24h]))",
          "legendFormat": "indexed",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Ingestion failure rate (24h)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "documind-prometheus"
      },
      "description": "Share of ingestion attempts that failed.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "documind-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(increase(documind_ingestion_documents_total{result=\"failed\"}[24h])) / clamp_min(sum(increase(documind_ingestion_documents_total[24h])), 1)",
          "legendFormat": "failure rate",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
