LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

DATABASE_URL=jdbc:postgresql://postgres:5432/documind
DATABASE_USER=documind
DATABASE_PASSWORD=documind

JWT_SECRET=
JWT_EXPIRY_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:3000

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=documind
S3_SECRET_KEY=documind-secret
S3_BUCKET=documind-documents

RETRIEVAL_TOP_K=6
RETRIEVAL_SIMILARITY_THRESHOLD=0.7
PII_REDACTION_MODE=THIRD_PARTY_ONLY
RETRIEVAL_RERANKER=lexical
RETRIEVAL_RERANK_WEIGHT=0.6

VECTOR_STORE=pgvector
QDRANT_HOST=qdrant
QDRANT_PORT=6334
QDRANT_COLLECTION=documind

KAFKA_BOOTSTRAP_SERVERS=kafka:9092

REDIS_HOST=redis
REDIS_PORT=6379

DEMO_SEED_ENABLED=true
DEMO_USER_EMAIL=demo@documind.test
DEMO_USER_PASSWORD=demo-password-2026

LOG_FORMAT=ecs

GRAFANA_PASSWORD=documind
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
